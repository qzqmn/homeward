# 複製為 .env 後修改：cp .env.example .env

POSTGRES_USER=homeward
# 密碼只用字母數字（會放進 migration 的連線網址）：openssl rand -hex 24
POSTGRES_PASSWORD=change-me-strong-password
POSTGRES_DB=homeward

REDIS_PASSWORD=change-me-redis-password

# Go 容器的運行身份，需與 /mnt/nas/homeward-media 的擁有者一致（用 `ls -ln` 查）
PUID=1000
PGID=1000

# 對外入口（Nginx）。只走 Tailscale 時把 WEB_BIND 設為本機 Tailscale IP（100.x.x.x）
WEB_BIND=0.0.0.0
WEB_PORT=8080

# ---- 映像（GitHub Actions 推送到 GHCR）----
# 你的 GitHub 帳號或組織名（小寫）
GH_OWNER=your-github-name
# latest = main 最新；也可指定 sha-xxxxxxx 或 1.0.0 以回滾/固定版本
IMAGE_TAG=latest

# ---- 對外網域（分享連結、OG 絕對網址用）----
# 正式環境請改成實際網域，例如 https://homeward.example.com（需 HTTPS，見 README 注意事項）
BASE_URL=http://localhost:8080
# 背景通知排程（半徑推播擴大 + 實際送出）執行間隔，秒
NOTIFY_INTERVAL_SEC=300
