# 複製為 .env 後修改：cp .env.example .env

POSTGRES_USER=homeward
# 密碼只用字母數字（會放進 migration 的連線網址）：openssl rand -hex 24
POSTGRES_PASSWORD=change-me-strong-password
POSTGRES_DB=homeward

REDIS_PASSWORD=change-me-redis-password

# Go 容器的運行身份，需與 /mnt/nas/homeward-media 的擁有者一致（用 `ls -ln` 查）
PUID=1000
PGID=1000

# 對外入口（Nginx）。只走 Tailscale 時把 WEB_BIND 設為本機 Tailscale IP（100.x.x.x）
WEB_BIND=0.0.0.0
WEB_PORT=8080

# ---- 映像（GitHub Actions 推送到 GHCR）----
# 你的 GitHub 帳號或組織名（小寫）
GH_OWNER=your-github-name
# latest = main 最新；也可指定 sha-xxxxxxx 或 1.0.0 以回滾/固定版本
IMAGE_TAG=latest

# ---- 對外網域（分享連結、OG 絕對網址用，走 Cloudflare Tunnel，所以是 https）----
BASE_URL=https://homeward.688689.xyz
# 背景通知排程（半徑推播擴大 + 實際送出）執行間隔，秒
NOTIFY_INTERVAL_SEC=300
# 上傳單檔上限（MB），超過後端直接拒收（預設 10）
#MAX_UPLOAD_MB=10
# 已結案案件軌跡的保留天數（背景排程每小時清理，預設 14）
#TRACK_RETENTION_DAYS=14

# ---- Telegram 登入與通知 ----
# 去 Telegram 找 @BotFather 建一個 bot 拿到的 token。兩個用途：1) 驗證 Telegram
# Login 的簽章；2) 通知送達時用 Bot API 直接發訊息給已登入的使用者（必須先跟
# 你🗨 bot 對話過一次，Telegram 才允許發送）。步驟見 README「Telegram 登入設定」。
TELEGRAM_BOT_TOKEN=
# bot 的 username（不含 @，例如 MyHomewardBot）。公開資訊，前端用它顯示登入按鈕；
# 改這裡重啟後端即可，不用重新建置前端。
TELEGRAM_BOT_USERNAME=

# 通知要送去哪裡，由你自己的服務決定（例如 Cloudflare Worker），後端只會把
# 通知內容 POST 過去。空字串時只會把內容印到後端 log，不會真的發送。
# 格式見 README「通知 webhook」。
# （改成在管理後台「設定」分頁配置 Resend 寄信與 webhook，改完即生效不用重啟；
#   這裡的 NOTIFY_WEBHOOK_URL 僅是舊部署的備用通路。）
NOTIFY_WEBHOOK_URL=

# ---- 資料庫備份（db-backup 服務，建議一定要開）----
# 備份輸出目錄：填 NAS 子目錄（例如 /mnt/nas/homeward-backups）讓 NAS 留第二份。
# 啟用前先 chown 給 PGID 的擁有者。打消怎麼還原請看 docker-compose 的註解。
#BACKUP_DIR=/mnt/nas/homeward-backups
# 每幾秒備份一次（預設 86400 = 每天）；一次保留幾份（預設 14 ≈ 兩週）
#BACKUP_INTERVAL_SEC=86400
#BACKUP_KEEP=14

# ---- 管理後台 ----
# 名單內的 Telegram id（逗號分隔）登入時自動升級為管理員（role='admin'），
# 第一次部署靠它拿到第一個管理員，不用進 VPS 跑 SQL。之後可以在後台的
# 「使用者」分頁直接升級/撤銷别的人。填你自己的 Telegram user id
# （對線上查 @userinfobot 那種機器人拿；不是手機號碼）。
ADMIN_TELEGRAM_IDS=

# ---- Cloudflare Tunnel（選用，讓 compose 一起管 cloudflared）----
# 取消下面兩行的註解並填入 token，cloudflared 就會跟其他服務一起啟動。
# token 來源：Cloudflare Zero Trust → Networks → Tunnels → 你的 tunnel → 安裝指令裡 --token 後面那串。
# 然後在該 tunnel 的 Public Hostname 把服務設成：類型 HTTP、網址 frontend-web:80
#COMPOSE_PROFILES=tunnel
#TUNNEL_TOKEN=
